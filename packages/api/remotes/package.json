{
  "name": "@ahel/dsh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@ahel/dsh-deque": "workspace:*",
    "@ahel/dsh-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-scope": "workspace:*"
  },
  "devDependencies": {
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-preset-registry": "workspace:*",
    "@ahel/dsh-api-gateway": "workspace:*",
    "@ahel/dsh-api-job-controller": "workspace:*",
    "@ahel/dsh-api-session-controller": "workspace:*",
    "@ahel/dsh-api-settings-controller": "workspace:*",
    "@ahel/dsh-api-workspace-controller": "workspace:*",
    "@ahel/dsh-api-workspace-files": "workspace:*",
    "@ahel/dsh-client-connection": "workspace:*",
    "@ahel/dsh-client-file-upload": "workspace:*",
    "@ahel/dsh-commands": "workspace:*",
    "@ahel/dsh-cordis-host-runner": "workspace:*",
    "@ahel/dsh-credentials": "workspace:*",
    "@ahel/dsh-file-reference": "workspace:*",
    "@ahel/dsh-goal": "workspace:*",
    "@ahel/dsh-host-plugin-inventory": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-message-feedback": "workspace:*",
    "@ahel/dsh-permission-presets": "workspace:*",
    "@ahel/dsh-schedule": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-session-reference": "workspace:*",
    "@ahel/dsh-settings": "workspace:*",
    "@ahel/dsh-subagent": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*",
    "@ahel/dsh-user-approval": "workspace:*",
    "@ahel/dsh-user-questions": "workspace:*",
    "@ahel/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@ahel/dsh-command-feedback": "workspace:*",
    "@ahel/dsh-api-terminal-controller": "workspace:*",
    "@ahel/dsh-plugin-manager": "workspace:*",
    "@ahel/dsh-client-ui-plugin-manager": "workspace:*",
    "@ahel/dsh-client-product-analytics": "workspace:*"
  }
}
