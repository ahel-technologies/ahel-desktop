{
  "name": "@ahel/dsh-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the DeepSeek Harness",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*",
    "@ahel/dsh-util-values": "workspace:*",
    "@ahel/dsh-workspace": "workspace:*",
    "@ahel/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@ahel/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*",
    "@ahel/dsh-typert-registry": "workspace:*",
    "@ahel/dsh-util-values": "workspace:*",
    "@ahel/dsh-workspace": "workspace:*",
    "@ahel/cordis": "workspace:~"
  }
}
