{
  "name": "@ahel/dsh-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ahel/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-terminal": "workspace:*",
    "@ahel/dsh-output-retention": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis-plugin-include": "workspace:~",
    "@ahel/cordis-plugin-loader": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-loop-testkit": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-terminal": "workspace:*",
    "@ahel/dsh-terminal-bash": "workspace:*",
    "@ahel/dsh-output-retention": "workspace:*",
    "@ahel/dsh-sandbox": "workspace:*",
    "@ahel/dsh-sandbox-policy": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-subprocess-local": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-jobs-local": "workspace:*",
    "@ahel/dsh-tool-jobs": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-session-projection": "workspace:*"
  }
}
