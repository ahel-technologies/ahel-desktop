{
  "name": "@ahel/dsh-lsp-stdio",
  "description": "Generic stdio language-server provider for the DeepSeek Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-fs": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-lsp": "workspace:*",
    "@ahel/dsh-subprocess": "workspace:*",
    "@ahel/dsh-timeout": "workspace:*"
  },
  "dependencies": {
    "@ahel/dsh-util-values": "workspace:*",
    "@ahel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-fs": "workspace:*",
    "@ahel/dsh-fs-local": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-lsp": "workspace:*",
    "@ahel/dsh-subprocess": "workspace:*",
    "@ahel/dsh-subprocess-local": "workspace:*",
    "@ahel/dsh-timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
