{
  "name": "@ahel/dsh-agent-tools",
  "description": "The local agent tool plane as a profile bundle: shell, filesystem tools, sandboxes, skills, subagents, PTC, workflows, jobs, goals, plan mode, web tools and opt-in telemetry rows, inserted over dsh-base for the headless, sdk and acp profiles",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahel-technologies/ahel-desktop.git",
    "directory": "packages/bundle/agent-tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@ahel/dsh-agent-instructions": "workspace:*",
