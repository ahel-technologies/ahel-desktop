    "@ahel/dsh-otel": "workspace:*",
    "@ahel/dsh-permission-presets": "workspace:*",
    "@ahel/dsh-plan-mode": "workspace:*",
    "@ahel/dsh-plugin-manager": "workspace:*",
    "@ahel/dsh-ptc-runtime-node": "workspace:*",
    "@ahel/dsh-pwsh-sandbox": "workspace:*",
    "@ahel/dsh-sandbox-local": "workspace:*",
    "@ahel/dsh-session-telemetry-otel": "workspace:*",
    "@ahel/dsh-shell-env": "workspace:*",
    "@ahel/dsh-skill": "workspace:*",
    "@ahel/dsh-skill-badge": "workspace:*",
