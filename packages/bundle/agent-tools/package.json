    "@ahel/dsh-tool-fs": "workspace:*",
    "@ahel/dsh-tool-fs-search": "workspace:*",
    "@ahel/dsh-tool-goal": "workspace:*",
    "@ahel/dsh-tool-jobs": "workspace:*",
    "@ahel/dsh-tool-present": "workspace:*",
