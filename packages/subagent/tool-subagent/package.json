{
  "name": "@ahel/dsh-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./model-selection-settings": {
      "types": "./lib/types/model-selection-settings.d.ts",
      "default": "./lib/model-selection-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/model-selection-settings.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-subagent": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/cordis": "workspace:~"
  },
  "dependencies": {
    "@ahel/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ahel/cordis-plugin-loader": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-session-persistence": "workspace:*",
    "@ahel/dsh-session-persistence-jsonl": "workspace:*",
    "@ahel/dsh-subagent": "workspace:*",
    "@ahel/dsh-subagent-spawn-in-process": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-jobs-local": "workspace:*",
    "@ahel/dsh-tool-jobs": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-session-projection": "workspace:*"
  }
}
