{
  "name": "@ahel/dsh-jobs-local",
  "description": "Process-local implementation of the DeepSeek Harness background job registry seam",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-timeout": "workspace:*",
    "@ahel/cordis": "workspace:~"
  },
  "dependencies": {
    "@ahel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis-plugin-include": "workspace:~",
    "@ahel/cordis-plugin-loader": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-loop-testkit": "workspace:*",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-scope": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-timeout": "workspace:*",
    "@ahel/cordis": "workspace:~"
  }
}
