{
  "name": "@ahel/dsh-experimental-speech-to-text-ahel",
  "description": "Cloud dictation through the signed-in ahel.ai account: one WAV to ahel.ai's metered transcription route",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahel-technologies/ahel-desktop.git",
    "directory": "packages/experimental/speech-to-text-ahel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@ahel/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-ahel-account": "workspace:*",
    "@ahel/dsh-experimental-speech-to-text": "workspace:*"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-ahel-account": "workspace:*",
    "@ahel/dsh-experimental-speech-to-text": "workspace:*"
  }
}
