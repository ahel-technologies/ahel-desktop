{
  "name": "@ahel/dsh-session-title",
  "description": "Log-backed session title service and provider registry for the DeepSeek Harness",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-title"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@ahel/dsh-util-values": "workspace:*",
    "@ahel/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-loop": "workspace:*",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-persistence-jsonl": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*"
  }
}
