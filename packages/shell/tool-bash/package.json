{
  "name": "@ahel/dsh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-shell": "workspace:*",
    "@ahel/dsh-shell-env": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-sandbox": "workspace:*",
    "@ahel/dsh-sandbox-policy": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/dsh-user-approval": "workspace:*",
    "@ahel/cordis": "workspace:~"
  },
  "dependencies": {
    "@ahel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-loop": "workspace:*",
    "@ahel/dsh-agent-loop-testkit": "workspace:*",
    "@ahel/dsh-shell": "workspace:*",
    "@ahel/dsh-shell-env": "workspace:*",
    "@ahel/dsh-bash-local": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-subprocess-local": "workspace:*",
    "@ahel/dsh-sandbox": "workspace:*",
    "@ahel/dsh-sandbox-policy": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-persistence-jsonl": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-jobs": "workspace:*",
    "@ahel/dsh-jobs-local": "workspace:*",
    "@ahel/dsh-tool-jobs": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/dsh-user-approval": "workspace:*",
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-session-projection": "workspace:*"
  }
}
