{
  "name": "@ahel/dsh-ahel-account",
  "description": "ahel.ai account sign-in for Ahel Desktop: one OAuth grant shared by the Ahel MCP server and Ahel models",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/ahel-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-default-model": "workspace:*",
    "@ahel/dsh-api-session-controller": "workspace:*",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-credentials": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-mcp-client": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@ahel/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-agent-default-model": "workspace:*",
    "@ahel/dsh-api-session-controller": "workspace:*",
    "@ahel/dsh-brand": "workspace:*",
    "@ahel/dsh-config-editor": "workspace:*",
    "@ahel/dsh-credentials": "workspace:*",
    "@ahel/dsh-credentials-local": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-mcp-client": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-session-projection": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*"
  }
}
