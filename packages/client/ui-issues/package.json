{
  "name": "@ahel/dsh-client-ui-issues",
  "description": "Team issues in the Web client: the Issues board and list, issue detail, New Issue, and Run with Ahel",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-api-remotes",
        "@ahel/dsh-api-session-controller",
        "@ahel/dsh-api-workspace-controller",
        "@ahel/dsh-client-locale",
        "@ahel/dsh-client-ui-layout",
        "@ahel/dsh-client-ui-renderer",
        "@ahel/dsh-client-ui-session",
        "@ahel/dsh-client-ui-sidebar",
        "@ahel/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-ahel-account": "workspace:*",
    "@ahel/dsh-api-remotes": "workspace:*",
    "@ahel/dsh-api-session-controller": "workspace:*",
    "@ahel/dsh-api-workspace-controller": "workspace:*",
    "@ahel/dsh-client-locale": "workspace:*",
    "@ahel/dsh-client-store": "workspace:*",
    "@ahel/dsh-client-test-runtime": "workspace:*",
    "@ahel/dsh-client-ui-layout": "workspace:*",
    "@ahel/dsh-client-ui-primitives": "workspace:*",
    "@ahel/dsh-client-ui-renderer": "workspace:*",
    "@ahel/dsh-client-ui-session": "workspace:*",
    "@ahel/dsh-client-ui-sidebar": "workspace:*",
    "@ahel/dsh-client-ui-slots": "workspace:*",
    "@ahel/dsh-client-ui-workspace": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*",
    "@ahel/dsh-workspace": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
