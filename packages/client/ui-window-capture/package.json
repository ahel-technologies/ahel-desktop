{
  "name": "@ahel/dsh-client-ui-window-capture",
  "description": "Window capture in the Ahel Desktop composer: the capture button, the global-shortcut row in Settings > General, and attaching the captured window's screenshot to the chat",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-window-capture"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-client-locale",
        "@ahel/dsh-client-ui-layout",
        "@ahel/dsh-client-ui-renderer",
        "@ahel/dsh-client-ui-conversation",
        "@ahel/dsh-client-ui-settings",
        "@ahel/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-client-locale": "workspace:*",
    "@ahel/dsh-client-ui-conversation": "workspace:*",
    "@ahel/dsh-client-ui-layout": "workspace:*",
    "@ahel/dsh-client-ui-primitives": "workspace:*",
    "@ahel/dsh-client-ui-renderer": "workspace:*",
    "@ahel/dsh-client-ui-settings": "workspace:*",
    "@ahel/dsh-client-ui-slots": "workspace:*",
    "@ahel/dsh-client-ui-workspace": "workspace:*",
    "@ahel/dsh-window-capture": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
