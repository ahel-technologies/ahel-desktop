{
  "name": "@ahel/dsh-client-ui-local-cli",
  "description": "Detected-on-this-computer rows in Settings > Models: turn on the Claude Code, Codex or Gemini CLI the person already signed into",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-local-cli"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-api-remotes",
        "@ahel/dsh-client-locale",
        "@ahel/dsh-client-ui-layout",
        "@ahel/dsh-client-ui-renderer",
        "@ahel/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-api-remotes": "workspace:*",
    "@ahel/dsh-client-locale": "workspace:*",
    "@ahel/dsh-client-ui-layout": "workspace:*",
    "@ahel/dsh-client-ui-primitives": "workspace:*",
    "@ahel/dsh-client-ui-renderer": "workspace:*",
    "@ahel/dsh-client-ui-settings-models": "workspace:*",
    "@ahel/dsh-client-ui-slots": "workspace:*",
    "@ahel/dsh-llm-local-cli": "workspace:*",
    "@ahel/dsh-typert-protocol": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
