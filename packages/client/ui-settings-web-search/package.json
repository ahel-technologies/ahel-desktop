{
  "name": "@ahel/dsh-client-ui-settings-web-search",
  "description": "Settings > General > Web search: Ahel Web Search status and its on switch",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-web-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-api-remotes",
        "@ahel/dsh-client-locale",
        "@ahel/dsh-client-ui-settings",
        "@ahel/dsh-client-ui-ahel-account"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ahel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-ahel-account": "workspace:*",
    "@ahel/dsh-api-remotes": "workspace:*",
    "@ahel/dsh-client-locale": "workspace:*",
    "@ahel/dsh-client-ui-ahel-account": "workspace:*",
    "@ahel/dsh-client-ui-primitives": "workspace:*",
    "@ahel/dsh-client-ui-renderer": "workspace:*",
    "@ahel/dsh-client-ui-settings": "workspace:*",
    "@ahel/dsh-client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
