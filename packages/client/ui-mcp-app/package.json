{
  "name": "@ahel/dsh-client-ui-mcp-app",
  "description": "MCP Apps card host: sandboxed ui:// cards for MCP tool results with the MCP Apps postMessage bridge",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-mcp-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-api-remotes",
        "@ahel/dsh-client-locale",
        "@ahel/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@ahel/dsh-typert-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-mcp-client": "workspace:*"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-agent": "workspace:*",
    "@ahel/dsh-api-remotes": "workspace:*",
    "@ahel/dsh-client-connection": "workspace:*",
    "@ahel/dsh-client-locale": "workspace:*",
    "@ahel/dsh-client-test-runtime": "workspace:*",
    "@ahel/dsh-client-ui-chat": "workspace:*",
    "@ahel/dsh-client-ui-conversation": "workspace:*",
    "@ahel/dsh-client-ui-primitives": "workspace:*",
    "@ahel/dsh-client-ui-renderer": "workspace:*",
    "@ahel/dsh-client-ui-slots": "workspace:*",
    "@ahel/dsh-client-ui-theme": "workspace:*",
    "@ahel/dsh-client-ui-tool": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-mcp-client": "workspace:*",
    "@ahel/dsh-mcp-resources": "workspace:*",
    "@ahel/dsh-system-prompt": "workspace:*",
    "@ahel/dsh-tools": "workspace:*",
    "@ahel/dsh-util-values": "workspace:*",
    "@ahel/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  }
}
