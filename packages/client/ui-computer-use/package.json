{
  "name": "@ahel/dsh-client-ui-computer-use",
  "description": "Computer-use approval card, stop control, activity log and settings for Ahel Desktop",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-computer-use"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ahel/dsh-api-remotes",
        "@ahel/dsh-client-locale",
        "@ahel/dsh-client-ui-approval",
        "@ahel/dsh-client-ui-conversation",
        "@ahel/dsh-client-ui-renderer",
        "@ahel/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@ahel/dsh-typert-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-computer-use-action-gate": "workspace:*"
  },
  "devDependencies": {
    "@ahel/cordis": "workspace:~",
    "@ahel/dsh-api-remotes": "workspace:*",
    "@ahel/dsh-client-locale": "workspace:*",
    "@ahel/dsh-client-shortcuts": "workspace:*",
    "@ahel/dsh-client-ui-approval": "workspace:*",
    "@ahel/dsh-client-ui-conversation": "workspace:*",
    "@ahel/dsh-client-ui-primitives": "workspace:*",
    "@ahel/dsh-client-ui-renderer": "workspace:*",
    "@ahel/dsh-client-ui-settings": "workspace:*",
    "@ahel/dsh-client-ui-slots": "workspace:*",
    "@ahel/dsh-computer-use-action-gate": "workspace:*",
    "@ahel/dsh-llm": "workspace:*",
    "@ahel/dsh-session": "workspace:*",
    "@ahel/schemastery": "workspace:~",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
