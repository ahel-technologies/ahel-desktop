{
  "name": "@ahel/dsh-host-frontend-static",
  "description": "SPA dist server for the Web shell: owns the webserver fallback seat, serving explicit index entries and static assets with traversal rejection and 404 misses",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/frontend-static"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ahel/dsh-host-webserver": "workspace:*",
    "@ahel/dsh-client-connection": "workspace:*",
    "@ahel/cordis": "workspace:~"
  },
  "dependencies": {
    "@ahel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ahel/cordis-plugin-loader": "workspace:~",
    "@ahel/dsh-client-connection": "workspace:*",
    "@ahel/dsh-credentials-local": "workspace:*",
    "@ahel/dsh-host-webserver": "workspace:*",
    "@ahel/cordis": "workspace:~"
  }
}
